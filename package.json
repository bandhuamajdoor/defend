{
  "name": "defend",
  "version": "1.0.0-preview.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "start": "next start --hostname 0.0.0.0",
    "build": "prisma generate && next build && esbuild src/worker.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/worker.js",
    "worker:dev": "tsx --env-file-if-exists=.env.local src/worker.ts",
    "worker": "node --env-file-if-exists=.env.local dist/worker.js",
    "db:local": "node --env-file-if-exists=.env.local scripts/local-db.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env.local prisma/seed.ts",
    "setup": "node scripts/setup.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/domain.test.ts tests/coaching.test.ts",
    "test:integration": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run tests/integration.test.ts",
    "test:e2e": "node --env-file-if-exists=.env.local scripts/browser-smoke.mjs",
    "eval": "tsx --env-file-if-exists=.env.local evals/run.ts",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dotenv": "16.6.1",
    "lucide-react": "0.468.0",
    "next": "16.4.3",
    "pg": "8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.58.2",
    "@types/node": "22.19.15",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "embedded-postgres": "18.4.0-beta.17",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "prettier": "3.8.1",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "vitest": "4.1.12"
  }
}
