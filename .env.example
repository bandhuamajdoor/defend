# Run npm run setup to create a gitignored .env.local with a random secret.
# Mock mode is implemented. Provider/pricing fields are reserved for the live adapter.
APP_ORIGIN=http://localhost:3000
APP_SECRET=replace-with-a-random-secret-before-running
DATABASE_URL=postgresql://defend:local-development-only@localhost:5432/defend
MODEL_PROVIDER=mock
MODEL_API_KEY=
MODEL_NAME=
MODEL_BASE_URL=
# Configure verified prices and positive ceilings before real-provider mode.
MODEL_INPUT_USD_PER_MILLION=
MODEL_OUTPUT_USD_PER_MILLION=
DAILY_SPEND_LIMIT_USD=0
SESSION_SPEND_LIMIT_USD=0
WORKER_CONCURRENCY=2
JOB_LEASE_SECONDS=120
PROVIDER_TIMEOUT_SECONDS=45
TTS_PROVIDER=browser
TTS_API_KEY=
PROJECT_TTL_DAYS=7
SAMPLE_TTL_HOURS=24
GUEST_TTL_DAYS=30
# Production requires HTTPS, real secrets, TLS DB and validated retention.

