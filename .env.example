# Run npm run setup to create a gitignored .env.local with a random secret.
# Default: useful guided sample coaching, no external model requests.
APP_ORIGIN=http://localhost:3000
APP_SECRET=replace-with-a-random-secret-before-running
DATABASE_URL=postgresql://defend:local-development-only@localhost:5432/defend
MODEL_PROVIDER=mock
MODEL_API_KEY=
MODEL_NAME=
MODEL_BASE_URL=
# For Groq Free: set MODEL_PROVIDER=groq, MODEL_NAME=openai/gpt-oss-20b,
# GROQ_API_KEY and MODEL_FREE_TIER_ONLY=true. Keep your account on Free.
GROQ_API_KEY=
MODEL_FREE_TIER_ONLY=false
# For local Ollama: MODEL_PROVIDER=ollama, MODEL_BASE_URL=http://127.0.0.1:11434,
# MODEL_NAME must match an installed local model. Cloud tags are rejected.
# Reservations count every attempt, including failures. No paid fallback exists.
MODEL_DAILY_REQUEST_LIMIT=120
MODEL_SESSION_REQUEST_LIMIT=24
WORKER_CONCURRENCY=2
JOB_LEASE_SECONDS=120
PROVIDER_TIMEOUT_SECONDS=45
TTS_PROVIDER=browser
PROJECT_TTL_DAYS=7
SAMPLE_TTL_HOURS=24
GUEST_TTL_DAYS=30
# Production requires HTTPS, real secrets, TLS DB and validated retention.

